# Copy to .env for Docker Compose. Keep real credentials out of Git.
# Default: local search index; connect an AI model to chat. No external calls by default.
JIRA_AI_PROVIDER=disabled
JIRA_AI_MODEL=
OPENAI_API_KEY=
# For OpenAI: JIRA_AI_PROVIDER=openai, set JIRA_AI_MODEL and OPENAI_API_KEY.
# For a tool-capable compatible server: JIRA_AI_PROVIDER=compatible,
# JIRA_AI_BASE_URL=http://host.docker.internal:11434/v1, set JIRA_AI_MODEL.
JIRA_AI_BASE_URL=
JIRA_AI_API_KEY=
# Optional OpenAI public web search. Also requires the chat opt-in checkbox.
JIRA_AI_WEB_ENABLED=false
# local = TF-IDF lexical vectors + FTS5; no embedding API needed.
# For semantic search, select openai or compatible and rebuild the ticket index.
JIRA_EMBEDDING_PROVIDER=local
JIRA_EMBEDDING_MODEL=embeddinggemma
JIRA_EMBEDDING_BASE_URL=
JIRA_EMBEDDING_API_KEY=
# The two private UI choices always use local Ollama, never hosted embedding APIs.
# Compose reaches the host via host.docker.internal; host development uses 127.0.0.1.
JIRA_LOCAL_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1

# Optional comma-separated models exposed in the chat selector.
JIRA_AI_MODELS=
JIRA_AI_REASONING_EFFORT=
JIRA_AI_PROJECT_ID=
JIRA_AI_ORGANIZATION_ID=

# Optional server-side aliases for models with a larger local context window.
# Build using config/ollama/*.Modelfile before enabling.
JIRA_AI_MODEL_ALIASES=

# Per-model conversation context profiles and declared context windows (tokens).
JIRA_AI_MODEL_CONTEXT_PROFILES=
JIRA_AI_MODEL_CONTEXT_WINDOWS=

# MongoDB metadata; Compose supplies the internal URI automatically.
# For host development: mongodb://127.0.0.1:27018
JIRA_MONGO_DATABASE=sprintlens
MONGO_PORT=27018

# Optional native Langfuse export; local MongoDB monitoring works without these.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
